        <mxCell id="Z5wVKjS9f_HaT-6LFpBN-58" value="&lt;div&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;SNS: fanout orderplaced event to multiple subscriber&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;SQS: durability. decouples, helps in independent scaling&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;EventBridge:&amp;nbsp;&lt;span style=&quot;background-color: oklch(0.99 0.004 106.471); color: oklch(0.304 0.04 213.681);&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;routes filtered events to targets (cross-service event routing)&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: oklch(0.99 0.004 106.471); color: oklch(0.304 0.04 213.681);&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot; face=&quot;Helvetica&quot;&gt;&lt;b&gt;KDS: Order and other activities gets real time streamed&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: oklch(0.99 0.004 106.471); color: oklch(0.304 0.04 213.681);&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot; face=&quot;Helvetica&quot;&gt;&lt;b style=&quot;&quot;&gt;ADF: managed data pipeline for long term storage&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#999999;strokeWidth=1;fillColor=#FFFFCC;fontColor=#6C767D;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;spacing=10;" parent="1" vertex="1">
